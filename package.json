{
  "name": "ScreenRec",
  "version": "1.0.0",
  "description": "Modern cross-platform desktop screen recorder built with Electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/HollmanRivero/ScreenRec-Mac.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "electron test-full-user-flow.js",
    "dist": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl"
  },
  "author": "Hollman Enrique Salazar Rivero <hollman.rivero@smart-things.site>",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hollmanrivero.screenrec",
    "productName": "ScreenRec",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
